# Contact form — SMTP (your own backend, no third-party form service).
# Copy this file to .env.local and fill it in. .env.local is gitignored.

# --- Gmail (easiest, no signup) -------------------------------------------
# SMTP_PASS is NOT your Google password. Enable 2-Step Verification, then
# create an App Password: https://myaccount.google.com/apppasswords
# Paste the 16 characters with no spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tanvidobaria@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx

# Where messages land. Defaults to SMTP_USER if omitted.
CONTACT_TO_EMAIL=tanvidobaria@gmail.com
